# Required: same secret token as the portfolio API
AGENT_TOKEN=change-me-to-a-long-random-string

# Optional: defaults to https://rohnelt.dev
API_URL=https://rohnelt.dev

# Optional: which folder to watch (defaults to /home/felipe/Documentos)
PROJECTS_DIR=/home/felipe/Documentos

# Optional tuning
DEBOUNCE_MS=5000
FULL_RESCAN_MS=3600000
